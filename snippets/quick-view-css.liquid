      .featured-collection {
        padding: 40px 20px;
        max-width: 1200px;
        margin: 0 auto;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen,
          Ubuntu, Cantarell, "Open Sans", "Helvetica Neue", sans-serif;
        color: #333;
      }

      /* Heading */
      .featured-collection__title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 8px;
        text-align: center;
      }

      /* Optional description */
      .featured-collection__description {
        font-size: 1rem;
        color: #666;
        text-align: center;
        max-width: 700px;
        margin: 0 auto 30px;
      }

      /* Product Grid */
      .featured-collection__grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
      }

      /* Product Card */
      .product-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        padding: 15px;
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: box-shadow 0.3s ease;
      }

      .product-card:hover {
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        border-color: #ddd;
      }

      /* Product Image */
      .product-card img {
        width: 100%;
        max-width: 180px;
        height: auto;
        object-fit: contain;
        margin-bottom: 12px;
        border-radius: 4px;
        display: block;
      }

      /* Product Title */
      .product-card__title {
        font-size: 1.1rem;
        font-weight: 600;
        text-align: center;
        margin-bottom: 6px;
        min-height: 48px; /* for uniform height */
      }

      /* Price */
      .product-card__price {
        font-size: 1rem;
        color: #1a73e8;
        font-weight: 700;
        margin-bottom: 12px;
      }

      /* Color Swatches Container */
      .product-card__swatches {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-bottom: 12px;
      }

      /* Each Color Swatch */
      .product-card__swatch {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 1px solid #ccc;
        cursor: pointer;
        transition: border-color 0.3s ease;
      }

      .product-card__swatch:hover,
      .product-card__swatch.active {
        border-color: #1a73e8;
      }

      /* Quick View Button */
      .product-card__quick-view-btn {
        background: #1a73e8;
        color: #fff;
        border: none;
        padding: 8px 16px;
        border-radius: 20px;
        cursor: pointer;
        font-weight: 600;
        transition: background 0.3s ease;
        text-transform: uppercase;
        font-size: 0.85rem;
      }

      .product-card__quick-view-btn:hover {
        background: #155bb5;
      }

      /* Quick View Modal Overlay */
      .quick-view-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 9999;
        display: none; /* hidden by default */
        align-items: center;
        justify-content: center;
        padding: 20px;
      }

      /* Quick View Modal */
      .quick-view-modal {
        background: #fff;
        max-width: 600px;
        width: 100%;
        border-radius: 8px;
        padding: 25px;
        position: relative;
        overflow-y: auto;
        max-height: 90vh;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
      }

      /* Close Button */
      .quick-view-close {
        position: absolute;
        top: 15px;
        right: 15px;
        background: transparent;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: #333;
      }

      /* Modal Product Image */
      .quick-view-image {
        width: 100%;
        max-height: 300px;
        object-fit: contain;
        margin-bottom: 20px;
        border-radius: 6px;
        display: block;
      }

      /* Modal Product Title */
      .quick-view-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 10px;
      }

      /* Modal Price */
      .quick-view-price {
        font-size: 1.25rem;
        color: #1a73e8;
        font-weight: 700;
        margin-bottom: 20px;
      }

      /* Add to Cart Button */
      .quick-view-add-to-cart {
        background: #1a73e8;
        color: #fff;
        border: none;
        padding: 12px 20px;
        border-radius: 25px;
        cursor: pointer;
        font-weight: 700;
        width: 100%;
        font-size: 1rem;
        transition: background 0.3s ease;
      }

      .quick-view-add-to-cart:hover {
        background: #155bb5;
      }

      /* Responsive */

      /* Tablet: 2 columns */
      @media (max-width: 992px) {
        .featured-collection__grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 20px;
        }

        .product-card img {
          max-width: 150px;
        }
      }

